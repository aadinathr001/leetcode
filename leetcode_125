s = "race a car"

class Solution:
    def isPalindrome(self, s: str) -> bool:
        clean_text = ""
        for x in s:
            if x.isalnum():
                clean_text = clean_text + x.lower()
                print(clean_text)
        if clean_text == clean_text[::-1]:
            return True
